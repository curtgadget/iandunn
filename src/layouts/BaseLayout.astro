---
// BaseLayout — the document shell for every page: head (meta, Open Graph,
// canonical URL, fonts, the taste-skill kit), the page type the kit and its
// checker read, and the kit's scripts at the end of <body>.
//
// The kit lives in public/assets (copied from the taste-skill, never edited)
// and loads as plain root-relative files. src/styles/global.css holds the
// dealt :root palette and type (deal.md) and is linked by Astro after these
// <link>s, as the kit requires.
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** The page's dealt moment id (deal.md), so its module preloads. */
  moment?: string;
}

const {
  title,
  description = 'Ian Dunn runs an engineering team at Pinterest and builds FutAve, TheraBasics and Center Ref at home in Los Angeles.',
  moment,
} = Astro.props;

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname;

// Link-preview image. The portrait is a stopgap — a dedicated 1200×630
// card is a worthwhile follow-up.
const ogImage = Astro.site
  ? new URL('/photos/chin-portrait.jpg', Astro.site).href
  : '/photos/chin-portrait.jpg';
---

<!doctype html>
<html lang="en" data-type="service" data-radius="soft" data-buttons="arrow" data-motion>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#e2e2e2" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <!-- The kind (deal.md, plan line 1): a service, people are hired. -->
    <meta name="site-kind" content="other" />
    <meta name="page-type" content="service" />

    <!-- Nunito, the dealt pairing: one family for display and text. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400..700&display=swap" rel="stylesheet" />

    <!-- The taste-skill kit, in the order system.md gives. -->
    <link rel="stylesheet" href="/assets/system.css" />
    <link rel="stylesheet" href="/assets/ui/cards.css" />
    <link rel="stylesheet" href="/assets/motion/motion.css" />
    <link rel="stylesheet" href="/assets/backgrounds/backgrounds.css" />
    <link rel="stylesheet" href="/assets/layout/layout.css" />
    <link rel="stylesheet" href="/assets/icons/icon.css" />

    <!-- The hero's entrance (motion.md): set before the first paint. -->
    <script is:inline>document.documentElement.classList.add('m-enter');setTimeout(()=>document.documentElement.classList.add('m-enter-done'),700)</script>
    {
      moment && (
        <Fragment>
          <script is:inline>document.documentElement.classList.add('mo-js');setTimeout(()=>document.documentElement.classList.add('mo-safe'),2500)</script>
          <link rel="modulepreload" href="/assets/moments/moments.js" />
          <link rel="modulepreload" href="/assets/moments/lib.js" />
          <link rel="modulepreload" href={`/assets/moments/${moment}/moment.js`} />
        </Fragment>
      )
    }
  </head>
  <body>
    <slot />
    <script is:inline type="module" src="/assets/system.js"></script>
    <script is:inline type="module" src="/assets/motion/motion.js"></script>
    <script is:inline type="module" src="/assets/layout/layout.js"></script>
  </body>
</html>
