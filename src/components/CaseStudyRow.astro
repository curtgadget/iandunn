---
// CaseStudyRow — one chapter of Home's "Apps I build and run" section, the
// dealt pinned-chapters moment (deal.md; moments/_demo/in-page-service.html).
// It renders one `li.mo-pc__step`: the app's mark, name and status as the
// h3, its one teaser line as the step's paragraph, and its real screenshot
// as the step's visual, which the moment moves into the shared frame while
// the section holds. Renders an entry from src/data/caseStudies.js; only
// src/pages/index.astro imports it.
import { Image } from 'astro:assets';

interface Props {
  study: {
    id: string;
    name: string;
    status: string;
    teaser: string;
    mark: { fit: string; src: string; alt: string };
    shot: ImageMetadata;
    shotAlt: string;
    shotFit: string;
  };
}
const { study: c } = Astro.props;

// A web screenshot fills the frame from its top; a small device shot (the
// watch) stands whole on the surface instead of being cropped and upscaled.
const contain = c.shotFit === 'contain';
---

<li class="mo-pc__step">
  <h3 class="cs-head">
    <span class:list={['cs-mark', `cs-mark--${c.mark.fit}`]}><img src={c.mark.src} alt="" width="28" height="28" loading="lazy" decoding="async" /></span>
    <span>{c.name}</span>
    <span class="pill cs-status">{c.status}</span>
  </h3>
  <p>{c.teaser}</p>
  <figure class:list={['mo-pc__visual', { 'cs-visual--contain': contain }]}>
    {
      contain ? (
        <Image src={c.shot} alt={c.shotAlt} loading="lazy" />
      ) : (
        <Image
          src={c.shot}
          alt={c.shotAlt}
          width={1279}
          height={850}
          widths={[640, 1279]}
          sizes="(max-width: 1023px) 100vw, 628px"
          fit="cover"
          position="top"
          loading="lazy"
        />
      )
    }
  </figure>
</li>

<style>
  /* the h3: mark, name and status on one line (page CSS inside the moment's step) */
  .cs-head {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }
  .cs-mark {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: var(--r-sm);
    overflow: hidden;
  }
  .cs-mark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .cs-mark--cover img {
    object-fit: cover;
  }
  /* the status as the kit's pill, in the heading's own colour (open or closed step alike) */
  .cs-status {
    font-family: var(--font-text);
    font-weight: 500;
    letter-spacing: 0;
    color: inherit;
  }
  /* inside the visual: web screenshots crop from the top; the watch stands whole */
  .mo-pc__visual :global(img) {
    object-position: 50% 0;
  }
  /* the watch shot (388px) stands at its own size, centred on the surface, never blown up */
  .cs-visual--contain {
    display: grid;
    place-items: center;
    background: var(--surface);
  }
  figure.mo-pc__visual.cs-visual--contain :global(img) {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    aspect-ratio: auto;
    object-fit: contain;
  }
</style>
