---
// CaseStudyRow — one Home-page case study: number rail, the argument
// (name, opinion, ONE featured field, meta), and a framed product shot.
// The row teases; the full three-field argument lives on /projects. Which
// field is featured comes from the entry's optional `tease` key
// ('problem' | 'tradeoff' | 'different' — default 'different').
// Renders an entry from src/data/caseStudies.js.
import { Image } from 'astro:assets';

interface Props {
  study: any;
}
const { study: c } = Astro.props;

const FIELD_LABELS = {
  problem: 'The problem that mattered',
  tradeoff: 'The tradeoff I made',
  different: 'Why it’s different',
};
const tease = (c.tease ?? 'different') as keyof typeof FIELD_LABELS;
---

<article class="cs-row">
  <span class="cs-num">{c.num}</span>

  <div class="cs-body">
    <div class="cs-title-line">
      <h3 class="cs-name"><a href={`/projects#${c.id}`}>{c.name}</a></h3>
      <span class="cs-status">
        <span class="dot" style={`background:${c.statusColor}`} />
        {c.status}
      </span>
    </div>

    <p class="cs-opinion">“{c.opinion}”</p>

    <div class="cs-detail">
      <p class="cs-label">{FIELD_LABELS[tease]}</p>
      <p class="cs-copy">{c[tease]}</p>
    </div>

    <p class="cs-meta">{c.meta}</p>
  </div>

  {
    c.shot && (
      <figure class="cs-figure">
        <a class="cs-shot-link" href={`/projects#${c.id}`} aria-label={`${c.name} case study`}>
          <div class:list={['cs-frame', `fit-${c.shotFit}`]}>
            <Image src={c.shot} alt={c.shotAlt} width={760} format="webp" loading="lazy" />
          </div>
        </a>
        <figcaption>{c.caption}</figcaption>
      </figure>
    )
  }
</article>

<style>
  .cs-row {
    display: grid;
    grid-template-columns: 56px 1.6fr 1fr;
    gap: 40px;
    align-items: start;
    padding: 44px 0;
    border-top: 1px solid var(--line);
  }

  .cs-num {
    font: 400 15px/1 var(--font-mono);
    color: var(--accent-strong);
    padding-top: 6px;
  }

  .cs-title-line {
    display: flex;
    align-items: baseline;
    gap: 16px;
  }
  .cs-name {
    font: 400 clamp(1.7rem, 3vw, 2.125rem) / 1 var(--font-head);
  }
  .cs-name a {
    color: inherit;
    text-decoration: none;
    transition: color 0.18s ease;
  }
  .cs-name a:hover {
    color: var(--accent-strong);
  }
  .cs-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--muted);
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  /* Capped at ~44ch so the quote breaks into two lines and reads as a
     pull-quote, not a long single rule of italic. */
  .cs-opinion {
    margin-top: 14px;
    max-width: 44ch;
    font: italic 400 clamp(1.25rem, 2.2vw, 1.5rem) / 1.3 var(--font-head);
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  .cs-detail {
    margin-top: 28px;
    max-width: 56ch;
  }
  /* Muted ink — the row's only terracotta is the number and hovers. */
  .cs-label {
    font: 500 10px/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .cs-copy {
    margin-top: 8px;
    font: 400 15px/1.65 var(--font-body);
    color: var(--ink-body);
  }

  /* A hairline discharges the meta from the argument above it — without
     it the line reads as another field. */
  .cs-meta {
    margin-top: 28px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    max-width: 56ch;
    font-size: 12px;
    color: var(--muted);
  }

  /* The framed shot: sand mat, ink border — product shots crop from the
     top, the watch shot sits contained on the mat. The whole frame links
     to its case study; the border warming is the hover cue. */
  .cs-shot-link {
    display: block;
  }
  .cs-shot-link:hover .cs-frame {
    border-color: var(--accent-strong);
  }
  .cs-frame {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: var(--paper-sand);
    border: 1px solid var(--ink);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.18s ease;
  }
  .cs-frame :global(img) {
    width: 100%;
    height: 100%;
    filter: var(--photo-filter);
  }
  .fit-cover :global(img) {
    object-fit: cover;
    object-position: top;
  }
  .fit-contain :global(img) {
    object-fit: contain;
    padding: 18px;
  }
  .cs-figure figcaption {
    margin-top: 7px;
    font: 500 10px/1.4 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .cs-row {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
