---
// SiteNav — the dealt nav-centre bar (deal.md; sections-library.md
// nav-centre): the initial mark and the name on the left line, the four
// words in the middle, Book a call as the one button on the right line.
// The kit's system.css lays it out and system.js runs the phone sheet,
// Esc and aria-expanded; no script or style of our own.
import { NAV_ITEMS, BOOK_CALL } from '../data/site.js';

interface Props {
  /** The nav label of the current page (marks it aria-current). */
  active?: string;
}
const { active } = Astro.props;
---

<header class="nav nav--centre">
  <div class="wrap nav__bar">
    <a class="skip-link" href="#top">Skip to content</a>
    <a class="nav__logo" href="/"><span class="mark mark--initial" aria-hidden="true">I</span>Ian Dunn</a>
    <nav class="nav__links" aria-label="Main">
      {
        NAV_ITEMS.map((item) => (
          <div class="nav__item">
            <a
              class="nav__link"
              href={item.href}
              aria-current={item.label === active ? 'page' : undefined}
            >
              {item.label}
            </a>
          </div>
        ))
      }
    </nav>
    <div class="nav__actions">
      <a class="btn btn--primary" href={BOOK_CALL.url}>{BOOK_CALL.label}<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"></path><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"></path></svg></a>
    </div>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-label="Menu">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
    </button>
  </div>
</header>
