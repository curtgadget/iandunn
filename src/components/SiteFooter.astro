---
// SiteFooter — the page's last section, `footer.closing` (deal.md): row 1 is
// the dealt close-photo (the h2, one line and Book a call, then a portrait
// never used above it), row 2 the dealt footer-dark directory (the name set
// large with the initial mark, the Pages, Apps and Contact columns, the legal
// row), all on the inverse oxblood ground. The kit's system.css lays it out.
// Words: copy.md, Close and Footer. Links: src/data/site.js.
import { Image } from 'astro:assets';
import { FOOTER_COLUMNS, BOOK_CALL } from '../data/site.js';
// The close's portrait, imported so Astro writes an 800 and a 1600 file (a phone
// never loads the 640 KB original). It stays in public/photos for the pages
// that still link it directly.
import closePhoto from '../../public/photos/glasses-portrait.jpg';

const year = new Date().getFullYear();
const isExternal = (url: string) => url.startsWith('http');
// Column spans: the name on span-4, Pages and Apps on span-2, Contact (six
// links, set in two short lists) on span-4, so the row ends on the right line.
const colClass = ['footer__col--pages', 'footer__col--apps', 'footer__col--contact'];
---

<footer class="footer closing footer--dark ground-inverse" id="contact" aria-labelledby="close-h">
  <div class="wrap">
    <div class="closing__cta close--photo">
      <div class="section-head--split">
        <div>
          <h2 id="close-h">A 30-minute call about your team or app</h2>
          <p class="t-lead">For advice on running an engineering team, or a second pair of eyes on an app you’re building.</p>
        </div>
        <a class="btn btn--primary" href={BOOK_CALL.url}>{BOOK_CALL.label}<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"></path><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"></path></svg></a>
      </div>
      <!-- the one portrait wide enough (1586px) for a strip across the 1280 .wrap -->
      <div class="close__media" style="--pos: 50% 33%">
        <Image src={closePhoto} alt="Ian Dunn adjusting his glasses" widths={[800, 1586]} sizes="(max-width: 639px) 100vw, 1280px" loading="lazy" data-source="client" data-subject="Ian Dunn" />
      </div>
    </div>
    <div class="closing__links">
      <div class="grid">
        <div class="span-4">
          <a class="footer__mark" href="/"><span class="mark mark--initial" aria-hidden="true">I</span>Ian Dunn</a>
        </div>
        {
          FOOTER_COLUMNS.map((col, i) => (
            <div class:list={['footer__col', colClass[i]]}>
              <h3>{col.title}</h3>
              <ul>
                {col.items.map((item) => (
                  <li>
                    <a
                      href={item.url}
                      target={isExternal(item.url) ? '_blank' : undefined}
                      rel={isExternal(item.url) ? 'noopener noreferrer' : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <div class="footer__legal">
        <span>&copy; {year} Ian Dunn</span>
        <span>The App Store and Google Play badges are trademarks of Apple and Google.</span>
      </div>
    </div>
  </div>
</footer>

<style>
  /* the initial tile at the footer's 48px name: a tile a little under the cap height
     with the letter set inside it (the kit's 1em tile leaves the letter no room) */
  .footer__mark .mark--initial {
    font-size: 0.5em;
    width: 1.6em;
    height: 1.6em;
  }
  /* the columns: Pages and Apps on two columns each, Contact on four, the row
     ending on the right line at every width (the kit sets three per row under 1024) */
  .footer__col--pages,
  .footer__col--apps {
    grid-column: auto / span 2;
  }
  .footer__col--contact {
    grid-column: auto / span 4;
  }
  .footer__col--contact ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(3, auto);
    grid-auto-flow: column;
    column-gap: var(--gutter);
  }
  @media (max-width: 1023px) {
    .footer__col--pages,
    .footer__col--apps {
      grid-column: auto / span 3;
    }
    .footer__col--contact {
      grid-column: auto / span 6;
    }
  }
  @media (max-width: 639px) {
    .footer__col--pages,
    .footer__col--apps {
      grid-column: auto / span 6;
    }
    .footer__col--contact {
      grid-column: 1 / -1;
    }
  }
</style>
