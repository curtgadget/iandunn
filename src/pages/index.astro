---
// Home — built to the dealt look (docs/pare/full-redesign/deal.md) with the
// words of copy.md, as a stack of screens (the kit's layout-v4.md):
//   1. hero        split: the h1, lead and two actions on span-6 (the 6/6 pair: the
//                  dealt span-5 sets this h1 on four lines, layout check hero-lines),
//                  one portrait on span-6 start-7 with one flat float card (1 screen)
//   2. #apps       the dealt moment pinned-chapters: three chapters, one per app,
//                  each app's real screenshot in the frame            (2 screens)
//   3. #story      the surface band (rhythm surface-pairs): text left, a
//                  portrait right, pointing at About                  (1 screen)
//   4. footer.closing (SiteFooter): close-photo + footer-dark          (1 screen)
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CaseStudyRow from '../components/CaseStudyRow.astro';
import { CASE_STUDIES } from '../data/caseStudies.js';
import { BOOK_CALL, EMAIL } from '../data/site.js';
---

<BaseLayout
  title="Ian Dunn: engineering manager in Los Angeles"
  description="Ian Dunn runs an engineering team at Pinterest and builds FutAve, TheraBasics and Center Ref at home in Los Angeles."
  moment="pinned-chapters"
>
  <!-- type: service
       deal: hero split, nav nav-centre, close close-photo, footer footer-dark, rhythm surface-pairs,
             buttons arrow, mark initial, palette oxblood-grey, pairing nunito, radius soft, no grounds
       moments: pinned-chapters in #apps (three apps shown in the space of one section) -->
  <SiteNav active="Home" />

  <main id="top">
    <section class="hero hero--split" data-enter aria-labelledby="hero-h">
      <div class="wrap"><div class="hero-text grid hero__grid">
        <div class="hero__text span-6">
          <h1 id="hero-h">Engineering manager who builds his own apps</h1>
          <p class="hero__lead">I run a team at Pinterest with no product manager, and build FutAve, TheraBasics and Center Ref at home in Los Angeles.</p>
          <div class="btn-row">
            <a class="btn btn--primary" href={BOOK_CALL.url}>{BOOK_CALL.label}<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"></path><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"></path></svg></a>
            <a class="btn btn--secondary" href={EMAIL.url}>{EMAIL.label}</a>
          </div>
        </div>
        <div class="hero__media span-6 start-7">
          <img src="/photos/chin-portrait.jpg" alt="Ian Dunn in a white T-shirt and glasses, his hand at his chin" width="724" height="1086" style="--ly-pos: 50% 30%" fetchpriority="high" />
          <div class="ly-float">
            <div class="ly-float__title">AYSO referee, U-12, most Saturdays</div>
          </div>
        </div>
      </div></div>
    </section>

    <!-- pinned-chapters (moments.md): the section is the host, two screens tall; moment.js holds it
         while the three apps open one at a time and the frame shows each one's screenshot -->
    <section class="section" id="apps" style="--h: 2" data-moment="pinned-chapters" aria-labelledby="apps-h">
      <div class="wrap mo-pc__grid">
        <div class="mo-pc__text">
          <div class="section-head">
            <h2 id="apps-h">Apps I build and run</h2>
            <p>FutAve and TheraBasics are live on iPhone, Android and the web. Center Ref is in public beta on Apple Watch.</p>
          </div>
          <ol class="mo-pc__steps">
            {CASE_STUDIES.map((c) => <CaseStudyRow study={c} />)}
          </ol>
          <p><a class="link" href="/projects">See all three projects</a></p>
        </div>
        <div class="mo-pc__visuals frame"></div>
      </div>
    </section>

    <section class="section ground-surface" id="story" aria-labelledby="story-h">
      <div class="wrap grid">
        <div class="span-5 stack-6">
          <h2 id="story-h">From a ringtone site to Pinterest</h2>
          <p class="t-lead">I ran 3gforfree.com, a ringtone business, for about eight years before I moved into engineering jobs. Then came Disney, NBC, Netflix, Spotify and Pinterest.</p>
          <p><a class="link" href="/about">Read the whole story</a></p>
        </div>
        <figure class="frame frame--photo story__photo span-6 start-7">
          <img src="/photos/pinterest-standing.jpg" alt="Ian Dunn standing in front of a painted arch at Pinterest" width="724" height="1086" loading="lazy" />
        </figure>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  /* the story's portrait: 1:1 on the split's right column (layout-v4.md, Pictures) */
  .story__photo {
    margin: 0;
    aspect-ratio: 1 / 1;
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  .story__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 18%;
  }
  /* stacked (640 to 1023): a 3:2 crop keeps the section on one screen, 48px under the text */
  @media (max-width: 1023px) {
    .story__photo {
      margin-top: var(--s-7);
    }
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .story__photo {
      aspect-ratio: 3 / 2;
    }
  }
</style>

<style is:global>
  /* pinned-chapters at rest below 1024 (it runs live from 1024): the moment's rest is as tall as its
     steps, so hold it to its two screens and let the steps fill them (layout-v4.md, the tablet: content
     of 1,130 to 1,856px takes two screens), each step's screenshot under its words and wide enough to
     read, so every section after it starts on a whole screen with no empty band between */
  @media (max-width: 1023px) {
    main > #apps[data-moment]:not(.is-live) .mo-pc__steps { gap: var(--s-7); }
    main > #apps[data-moment]:not(.is-live) .mo-pc__step { grid-template-columns: minmax(0, 1fr); }
    main > #apps[data-moment]:not(.is-live) .mo-pc__step :is(h3, p) { grid-column: 1; align-self: start; }
    main > #apps[data-moment]:not(.is-live) .mo-pc__step .mo-pc__visual { grid-column: 1; grid-row: auto; margin: var(--s-4) 0 0; }
    main > #apps[data-moment]:not(.is-live) .mo-pc__visual > img { aspect-ratio: 16 / 9; max-height: none; }
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    main > #apps[data-moment]:not(.is-live) { min-height: calc(2 * 100svh); }
    main > #apps[data-moment]:not(.is-live) .mo-pc__visual > img { max-height: 34svh; }
  }
  @media (max-width: 639px) {
    main > #apps[data-moment]:not(.is-live) { min-height: calc(2 * 100lvh); }
    main > #apps[data-moment]:not(.is-live) .mo-pc__visual > img { aspect-ratio: 4 / 3; }
  }
</style>
