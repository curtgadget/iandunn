---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CaseStudyRow from '../components/CaseStudyRow.astro';
import Plate from '../components/Plate.astro';
import { CASE_STUDIES } from '../data/caseStudies.js';

// Home leads with the three shipped-or-shipping case studies;
// Stonefold lives on the Case Studies page only.
const featured = CASE_STUDIES.slice(0, 3);

// Off the clock — each role's copy ties back to the thesis.
const weekend = [
  {
    role: 'People’s Warden',
    org: 'Christ the Good Shepherd · Episcopal',
    tie: 'Elected to represent the laity on the vestry. Less authority than the title suggests, more showing up — which is most of what leadership is.',
  },
  {
    role: 'Board Member',
    org: 'Good Shepherd Manor · Leimert Park',
    tie: 'Affordable senior housing with long roots. Governance and stewardship: keeping a system steady for the people living inside it.',
  },
  {
    role: 'Livestream Producer',
    org: 'Sundays, 10 a.m.',
    tie: 'Built the parish’s broadcast stack from scratch — thumbnails, bulletins, clipping, all automated. It goes live every Sunday, and it runs without me.',
  },
  {
    role: 'AYSO Regional Referee',
    org: 'U-12, most Saturdays',
    tie: 'Whistle in hand in my kids’ league. The weekend job that quietly turned into Center Ref.',
  },
];
---

<BaseLayout title="Ian Dunn">
  <SiteNav active="Home" />

  <main id="main">
    <!-- HERO — quiet paper, one declarative thesis ───────────── -->
    <section class="section hero">
        <div class="hero-text">
          <h1 class="hero-thesis">
            The best systems run without you<span class="period">.</span>
          </h1>
          <p class="hero-lede">
            I run my team at Pinterest by the same rule I ship side projects
            by: know exactly who it’s for, cut what doesn’t serve them, and
            then get out of the way. Eight years a founder before a
            decade-plus building for Disney, NBC, Netflix, and Spotify.
          </p>

          <div class="hero-actions">
            <a class="cta" href="/projects">Read the case studies →</a>
            <a class="cta-ghost" href="/about">The long way in →</a>
          </div>
        </div>

        <figure class="hero-photo">
          <div class="hero-frame">
            <img src="/photos/chin-portrait.jpg" alt="Ian Dunn" loading="eager" />
          </div>
          <figcaption>Los Angeles · Belizean roots · whistle on Saturdays</figcaption>
        </figure>
      </section>

    <!-- CASE STUDIES ─────────────────────────────────────────── -->
    <section class="section case-studies">
    <div class="block-head">
      <div>
        <p class="eyebrow">Case studies</p>
        <h2 class="block-title">Things I’m building</h2>
      </div>
      <a class="block-link" href="/projects">All case studies →</a>
    </div>

      {featured.map((c) => <CaseStudyRow study={c} />)}
    </section>

    <!-- OFF THE CLOCK ────────────────────────────────────────── -->
    <section class="section service">
    <div class="service-intro">
      <p class="eyebrow">Off the clock</p>
      <h2 class="block-title">The weekend</h2>
      <p class="service-blurb">
        The other half of the week — a small Episcopal parish in L.A., a
        board seat, and a livestream rig that goes live at 10 a.m. sharp.
      </p>

      <!-- The artifact slot. The handoff wants a photo of the livestream
           rig here; the portrait stands in until that shot exists. -->
      <div class="rig">
        <Plate src="/photos/stool-seated.jpg" alt="Ian Dunn, seated" aspect="4 / 5" />
      </div>
    </div>

    <div class="service-list">
      {
        weekend.map((row) => (
          <article class="service-row">
            <div class="service-line">
              <h3 class="service-role">{row.role}</h3>
              <span class="service-org">{row.org}</span>
            </div>
            <p class="service-copy">{row.tie}</p>
          </article>
        ))
      }
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  /* ── Hero — quiet paper, the thesis in ink ──────────────── */
  .hero {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 64px;
    align-items: center;
    padding-block: clamp(3.5rem, 8vw, 5.5rem) clamp(3rem, 7vw, 5rem);
  }
  .hero-thesis {
    font: 400 clamp(2.625rem, 6.5vw, 4.5rem) / 1.06 var(--font-head);
    text-wrap: pretty;
  }
  .period {
    color: var(--accent);
  }
  .hero-lede {
    margin-top: 26px;
    max-width: 540px;
    font: 400 17px/1.65 var(--font-body);
    color: var(--ink-soft);
  }

  .hero-actions {
    margin-top: 34px;
    display: flex;
    align-items: center;
    gap: 24px;
  }
  /* An outlined button holds the eye without shouting — the terracotta
     stays in reserve for the period and interactions. */
  .cta {
    display: inline-block;
    border: 1px solid var(--ink);
    color: var(--ink);
    padding: 14px 25px;
    font: 500 14px/1 var(--font-body);
    text-decoration: none;
    transition: background 0.18s ease, color 0.18s ease;
  }
  .cta:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .cta-ghost {
    font: 500 14px/1 var(--font-body);
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    padding-bottom: 3px;
    transition: color 0.18s ease;
  }
  .cta-ghost:hover {
    color: var(--accent-strong);
  }

  /* The portrait: desktop only, hairline frame, the site's warm grade. */
  .hero-photo {
    max-width: 300px;
    width: 100%;
    justify-self: end;
  }
  .hero-frame {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .hero-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: var(--photo-filter);
  }
  .hero-photo figcaption {
    margin-top: 8px;
    font: 500 10px/1.4 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ── Case studies ───────────────────────────────────────── */
  .case-studies {
    padding-block: 72px;
  }
  .block-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }
  .block-title {
    margin-top: 10px;
    font: 400 clamp(2rem, 4vw, 2.625rem) / 1.08 var(--font-head);
  }
  .block-link {
    font-size: 13px;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.18s ease;
  }
  .block-link:hover {
    color: var(--accent-strong);
  }

  /* ── Off the clock ──────────────────────────────────────── */
  .service {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 64px;
    align-items: start;
    background: var(--paper-sand);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding-block: 72px;
  }
  .service-blurb {
    margin-top: 18px;
    max-width: 340px;
    font: 400 16px/1.6 var(--font-body);
    color: var(--ink-body);
  }

  .rig {
    margin-top: 2.25rem;
    max-width: 360px;
  }

  .service-row {
    padding: 24px 0;
    border-top: 1px solid var(--line);
  }
  .service-row:last-child {
    border-bottom: 1px solid var(--line);
  }
  .service-line {
    display: flex;
    align-items: baseline;
    gap: 14px;
    justify-content: space-between;
  }
  .service-role {
    font: 400 clamp(1.35rem, 2.5vw, 1.625rem) / 1.15 var(--font-head);
  }
  .service-org {
    font-size: 12px;
    color: var(--muted);
    flex: none;
  }
  .service-copy {
    margin-top: 10px;
    max-width: 560px;
    font: 400 15px/1.65 var(--font-body);
    color: var(--ink-body);
  }

  /* ── Responsive ─────────────────────────────────────────── */
  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 40px;
      padding-block: 48px;
    }
    /* Statement first, then the portrait at real size — the figure
       follows the text in the single-column stack. */
    .hero-photo {
      justify-self: start;
      max-width: 380px;
    }
    .hero-actions {
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
    }
    .service {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
</style>
