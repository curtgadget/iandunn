---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageHeader from '../components/PageHeader.astro';

// Posts live in src/content/writing/ — newest first.
const posts = (await getCollection('writing')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// timeZone UTC — frontmatter dates parse as UTC midnight, and local
// formatting would shift them back a day.
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

// The four categories the writing is filed under (from the brief).
const categories = [
  {
    name: 'Building',
    desc: 'Side projects, weekend code, and the actual mechanics of shipping things with three kids in the house.',
  },
  {
    name: 'Leading',
    desc: 'Engineering management: hiring, feedback, and what changes when you stop writing code for a living.',
  },
  {
    name: 'Learning',
    desc: 'Books, talks, and papers worth underlining, including the things I got wrong on the second read.',
  },
  {
    name: 'Life',
    desc: 'Fatherhood, faith, Los Angeles, Belize, the church livestream, and the Saturday sideline.',
  },
];
---

<BaseLayout
  title="Writing — Ian Dunn"
  description="Notes from Ian Dunn on building, leading, learning, and life."
>
  <SiteNav active="Writing" />

  <main id="main">
    <PageHeader
      eyebrow="Writing"
      title="The notebook"
      intro="Short pieces on building, leading, learning, and life."
    />

    <section class="section categories">
      <div class="category-grid">
        {
          categories.map((c) => (
            <article class="category">
              <h2 class="category-name">{c.name}</h2>
              <p class="category-desc">{c.desc}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section archive">
      <p class="eyebrow">The archive</p>
      {
        posts.map((post) => (
          <article class="post-row">
            <p class="post-meta">
              {post.data.category} · {fmt(post.data.date)}
            </p>
            <h2 class="post-title">
              <a href={`/writing/${post.id}/`}>{post.data.title}</a>
            </h2>
            <p class="post-desc">{post.data.description}</p>
          </article>
        ))
      }
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .categories {
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }
  /* hairline gap-grid — these are informational, not links */
  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .category {
    background: var(--paper);
    padding: 26px 22px;
  }
  .category-name {
    font: 400 24px/1 var(--font-head);
  }
  .category-desc {
    margin-top: 10px;
    font: 400 14px/1.6 var(--font-body);
    color: var(--ink-body);
  }

  .archive {
    padding-bottom: clamp(3.5rem, 8vw, 6rem);
  }
  .post-row {
    margin-top: 18px;
    padding: 26px 0;
    border-top: 1px solid var(--line);
  }
  .post-row:last-child {
    border-bottom: 1px solid var(--line);
  }
  .post-meta {
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .post-title {
    margin-top: 12px;
    font: 400 clamp(1.5rem, 3vw, 2rem) / 1.15 var(--font-head);
  }
  .post-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.18s ease;
  }
  .post-title a:hover {
    color: var(--accent-strong);
  }
  .post-desc {
    margin-top: 10px;
    max-width: 62ch;
    font: 400 15px/1.65 var(--font-body);
    color: var(--ink-body);
  }
</style>
