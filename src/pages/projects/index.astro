---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import StoreBadges from '../../components/StoreBadges.astro';
import { CASE_STUDIES } from '../../data/caseStudies.js';

// The full argument in four parts — same data the Home rows draw from.
---

<BaseLayout
  title="Case studies — Ian Dunn"
  description="Case studies from Ian Dunn — FutAve, TheraBasics, Center Ref, and Stonefold. One opinion per product."
>
  <SiteNav active="Case studies" />

  <main id="main">
    <!-- PAGE HEAD ─────────────────────────────────────────────── -->
    <header class="section page-head">
      <p class="head-eyebrow">Case studies</p>
      <h1 class="head-title">One opinion per product<span class="period">.</span></h1>
      <p class="head-lede">
        Four projects, each with the problem that mattered, the tradeoff
        I chose, and why the approach is different. Built slowly, on
        nights and weekends, around a day job and three kids.
      </p>
    </header>

    <section class="section case-list">
      {
        CASE_STUDIES.map((c) => (
          <article class="case" id={c.id}>
            <div class="case-rail">
              <span class:list={['case-mark', `is-${c.mark.fit}`]}>
                {c.mark.fit === 'mono' ? (
                  <span class="mark-mono" aria-hidden="true">
                    {c.name.charAt(0)}
                  </span>
                ) : (
                  <img src={c.mark.src} alt={c.mark.alt} loading="lazy" decoding="async" />
                )}
              </span>
              <p class="case-num">{c.num}</p>
              <h2 class="case-name">{c.name}</h2>
              <span class="case-status">
                <span class="dot" style={`background:${c.statusColor}`} />
                {c.status}
              </span>
              <p class="case-meta">{c.meta}</p>
              {c.url && (
                <a class="case-link" href={c.url} target="_blank" rel="noopener noreferrer">
                  {c.cta} →
                </a>
              )}
              {c.stores && (
                <div class="case-stores">
                  <StoreBadges
                    ios={c.stores.ios}
                    android={c.stores.android}
                    height={30}
                    label={c.name}
                    direction="column"
                  />
                </div>
              )}
            </div>

            <div class="case-body">
              <p class="case-opinion">“{c.opinion}”</p>

              <div class:list={['case-detail', { 'no-shot': !c.shot }]}>
                <div class="case-fields">
                  <div>
                    <p class="case-label">The problem that mattered</p>
                    <p class="case-copy">{c.problem}</p>
                  </div>
                  <div>
                    <p class="case-label">The tradeoff I made</p>
                    <p class="case-copy">{c.tradeoff}</p>
                  </div>
                  <div>
                    <p class="case-label">Why it’s different</p>
                    <p class="case-copy">{c.different}</p>
                  </div>
                </div>

                {c.shot && (
                  <figure class="case-figure">
                    <div class:list={['case-frame', `fit-${c.shotFit}`]}>
                      <Image src={c.shot} alt={c.shotAlt} width={760} format="webp" loading="lazy" />
                    </div>
                    <figcaption>{c.caption}</figcaption>
                  </figure>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  /* ── Page head — paper, like every other page ───────────── */
  .page-head {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(1.75rem, 4vw, 2.75rem);
  }
  .head-eyebrow {
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .head-title {
    margin-top: 18px;
    font: 400 clamp(2.625rem, 6vw, 4rem) / 1.06 var(--font-head);
    text-wrap: pretty;
  }
  .period {
    color: var(--accent);
  }
  .head-lede {
    margin-top: 22px;
    max-width: 600px;
    font: 400 17px/1.65 var(--font-body);
    color: var(--ink-soft);
  }

  /* ── Case articles ──────────────────────────────────────── */
  .case-list {
    padding-block: 24px 72px;
  }
  .case {
    display: grid;
    grid-template-columns: 0.85fr 2.6fr;
    gap: 48px;
    align-items: start;
    padding: 52px 0;
    border-bottom: 1px solid var(--line);
    scroll-margin-top: 24px; /* breathing room when deep-linked from home */
  }

  /* ── Left rail ──────────────────────────────────────────── */
  .case-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    background: var(--paper-sand);
    border: 1px solid var(--line);
    overflow: hidden;
  }
  .case-mark.is-contain img {
    max-width: 56%;
    max-height: 56%;
    object-fit: contain;
  }
  .case-mark.is-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .mark-mono {
    font: 400 1.6rem/1 var(--font-head);
    color: var(--muted);
  }
  .case-num {
    margin-top: 16px;
    font: 400 15px/1 var(--font-mono);
    color: var(--accent-strong);
  }
  .case-name {
    margin-top: 10px;
    font: 400 clamp(2rem, 3.4vw, 2.5rem) / 1.05 var(--font-head);
  }
  .case-status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 10px;
    font-size: 12px;
    color: var(--muted);
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }
  /* The rail reads as two clusters: identity (mark, number, name, status)
     and action (meta, link, stores) — this gap is the seam between them. */
  .case-meta {
    margin-top: 30px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--muted);
  }
  .case-link {
    display: inline-block;
    margin-top: 16px;
    font-size: 14px;
    font-weight: 500;
    color: var(--accent-strong);
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 2px;
    transition: color 0.18s ease, border-color 0.18s ease;
  }
  .case-link:hover {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }
  .case-stores {
    margin-top: 20px;
  }

  /* ── The argument column ────────────────────────────────── */
  /* A step below the 40px rail name, so each row has one title voice —
     the name identifies, the quote argues. */
  .case-opinion {
    max-width: 30ch;
    font: italic 400 clamp(1.375rem, 2.4vw, 1.75rem) / 1.3 var(--font-head);
    color: var(--ink-soft);
    text-wrap: pretty;
  }
  .case-detail {
    margin-top: 30px;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 36px;
    align-items: start;
  }
  .case-detail.no-shot {
    grid-template-columns: 1fr;
  }
  /* Field-to-field space must clear the copy's own line-height (~25px),
     or the three fields fuse into one column of text. */
  .case-fields {
    display: grid;
    gap: 34px;
  }
  /* Labels are scaffolding — muted ink, so the terracotta stays with
     the number and the links. */
  .case-label {
    font: 500 10px/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .case-copy {
    margin-top: 8px;
    max-width: 62ch; /* keeps Stonefold's full-width row readable */
    font: 400 15px/1.65 var(--font-body);
    color: var(--ink-body);
  }

  /* ── The framed shot — same treatment as the Home rows ──── */
  .case-frame {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: var(--paper-sand);
    border: 1px solid var(--ink);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .case-frame :global(img) {
    width: 100%;
    height: 100%;
    filter: var(--photo-filter);
  }
  .fit-cover :global(img) {
    object-fit: cover;
    object-position: top;
  }
  .fit-contain :global(img) {
    object-fit: contain;
    padding: 18px;
  }
  .case-figure figcaption {
    margin-top: 7px;
    font: 500 10px/1.4 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ── Responsive ─────────────────────────────────────────── */
  @media (max-width: 760px) {
    .case {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .case-detail {
      grid-template-columns: 1fr;
    }
  }
</style>
