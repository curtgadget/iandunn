---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
// Cloudflare Pages serves dist/404.html automatically for unknown routes.
---

<BaseLayout title="Not found — Ian Dunn" description="That page doesn’t exist.">
  <SiteNav />

  <main id="main">
    <section class="section lost">
      <p class="eyebrow">404</p>
      <h1 class="lost-title">That page isn’t here<span class="period">.</span></h1>
      <p class="lost-note">
        The address may have changed, or it never existed. Everything that
        does exist is one click away.
      </p>
      <a class="lost-link" href="/">Back to the home page →</a>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .lost {
    padding-block: clamp(4rem, 12vw, 8rem);
  }
  .lost-title {
    margin-top: 14px;
    font: 400 clamp(2.2rem, 6vw, 3.5rem) / 1.06 var(--font-head);
  }
  .period {
    color: var(--accent);
  }
  .lost-note {
    margin-top: 18px;
    max-width: 46ch;
    font: 400 17px/1.65 var(--font-body);
    color: var(--ink-body);
  }
  .lost-link {
    display: inline-block;
    margin-top: 26px;
    font-size: 14px;
    font-weight: 500;
    color: var(--accent-strong);
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 2px;
    transition: color 0.18s ease, border-color 0.18s ease;
  }
  .lost-link:hover {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }
</style>
